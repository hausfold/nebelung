color-link default "#d7d7d7"
color-link comment "#9a9a9a"
color-link selection "#d7d7d7,#494949"
color-link hlsearch "#9be0d5"

color-link identifier "#8db4f3"
color-link identifier.class "#8db4f3"
color-link identifier.var "#8db4f3"

color-link constant "#f5b58e"
color-link constant.number "#f5b58e"
color-link constant.string "#abe1a6"

color-link symbol "#f2c4e5"
color-link symbol.brackets "#efcece"
color-link symbol.tag "#8db4f3"

color-link type "#8db4f3"
color-link type.keyword "#f7e2b5"

color-link special "#f2c4e5"
color-link statement "#c9a8f1"
color-link preproc "#f2c4e5"

color-link underlined "#91dbe8"
color-link error "bold #ed8fa9"
color-link todo "bold #f7e2b5"

color-link diff-added "#abe1a6"
color-link diff-modified "#f7e2b5"
color-link diff-deleted "#ed8fa9"

color-link gutter-error "#ed8fa9"
color-link gutter-warning "#f7e2b5"

color-link scrollbar "#9a9a9a"
color-link statusline "#d7d7d7,#191919"
color-link tabbar "#d7d7d7,#191919"
color-link indent-char "#494949"
color-link line-number "#494949"
color-link current-line-number "#b5bff8"

color-link cursor-line "#343434,#d7d7d7"
color-link color-column "#343434"
color-link type.extended "default"
