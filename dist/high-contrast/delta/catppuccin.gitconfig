
[delta "catppuccin-mocha"]
	blame-palette = "#060606 #020202 #000000 #1e1e1e #3a3a3a"
	commit-decoration-style = "#737373" bold box ul
	dark = true
	file-decoration-style = "#737373"
	file-style = "#ffffff"
	hunk-header-decoration-style = "#737373" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#c6c6c6"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#737373"
	line-numbers-minus-style = bold "#ed8fa9"
	line-numbers-plus-style = bold "#abe1a6"
	line-numbers-right-style = "#737373"
	line-numbers-zero-style = "#737373"
	# 35% red 65% base
	minus-emph-style = bold syntax "#57363f"
	# 20% red 80% base
	minus-style = syntax "#342227"
	# 35% green 65% base
	plus-emph-style = bold syntax "#40533e"
	# 20% green 80% base
	plus-style = syntax "#273226"
	map-styles = \
		bold purple => syntax "#4a3f58", \
		bold blue => syntax "#354359", \
		bold cyan => syntax "#375055", \
		bold yellow => syntax "#5a5343"
	# Should match the name of the bat theme
	syntax-theme = Catppuccin Mocha
