
[delta "catppuccin-mocha"]
	blame-palette = "#090909 #040404 #010101 #222222 #3d3d3d"
	commit-decoration-style = "#737373" bold box ul
	dark = true
	file-decoration-style = "#737373"
	file-style = "#ffffff"
	hunk-header-decoration-style = "#737373" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#c6c6c6"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#737373"
	line-numbers-minus-style = bold "#ed8fa9"
	line-numbers-plus-style = bold "#abe1a6"
	line-numbers-right-style = "#737373"
	line-numbers-zero-style = "#737373"
	# 35% red 65% base
	minus-emph-style = bold syntax "#593841"
	# 20% red 80% base
	minus-style = syntax "#362429"
	# 35% green 65% base
	plus-emph-style = bold syntax "#425540"
	# 20% green 80% base
	plus-style = syntax "#293428"
	map-styles = \
		bold purple => syntax "#4c415a", \
		bold blue => syntax "#37455b", \
		bold cyan => syntax "#395257", \
		bold yellow => syntax "#5c5545"
	# Should match the name of the bat theme
	syntax-theme = Catppuccin Mocha
