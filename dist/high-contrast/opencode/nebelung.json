{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "base": "#090909",
    "mantle": "#040404",
    "crust": "#010101",
    "text": "#ffffff",
    "subtext0": "#c6c6c6",
    "subtext1": "#e3e3e3",
    "surface0": "#222222",
    "surface1": "#3d3d3d",
    "surface2": "#575757",
    "overlay0": "#737373",
    "overlay1": "#8e8e8e",
    "overlay2": "#ababab",
    "blue": "#8db4f3",
    "lavender": "#b5bff8",
    "sapphire": "#7dc6e7",
    "sky": "#91dbe8",
    "teal": "#9be0d5",
    "green": "#abe1a6",
    "yellow": "#f7e2b5",
    "peach": "#f5b58e",
    "maroon": "#e6a3ad",
    "red": "#ed8fa9",
    "mauve": "#c9a8f1",
    "pink": "#f2c4e5",
