# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#ffffff"

# Main text color
theme[main_fg]="#434343"

# Title color for boxes
theme[title]="#434343"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#2a6ae8"

# Background color of selected item in processes box
theme[selected_bg]="#c7c7c7"

# Foreground color of selected item in processes box
theme[selected_fg]="#2a6ae8"

# Color of inactive/disabled text
theme[inactive_fg]="#8d8d8d"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#d78d7d"

# Background color of the percentage meters
theme[meter_bg]="#c7c7c7"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#d78d7d"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#8545e3" #Mauve
theme[mem_box]="#4a9e3a" #Green
theme[net_box]="#de5059" #Maroon
theme[proc_box]="#2a6ae8" #Blue

# Box divider line and small boxes line color
theme[div_line]="#a1a1a1"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#4a9e3a"
theme[temp_mid]="#d99137"
theme[temp_end]="#ca2a40"

# CPU graph colors (Teal -> Lavender)
theme[cpu_start]="#2f9197"
theme[cpu_mid]="#379eb1"
theme[cpu_end]="#7589f3"

# Mem/Disk free meter (Mauve -> Lavender -> Blue)
theme[free_start]="#8545e3"
theme[free_mid]="#7589f3"
theme[free_end]="#2a6ae8"

# Mem/Disk cached meter (Sapphire -> Lavender)
theme[cached_start]="#379eb1"
theme[cached_mid]="#2a6ae8"
theme[cached_end]="#7589f3"

# Mem/Disk available meter (Peach -> Red)
theme[available_start]="#f66d2d"
theme[available_mid]="#de5059"
theme[available_end]="#ca2a40"

# Mem/Disk used meter (Green -> Sky)
theme[used_start]="#4a9e3a"
theme[used_mid]="#2f9197"
theme[used_end]="#30a4de"

# Download graph colors (Peach -> Red)
theme[download_start]="#f66d2d"
theme[download_mid]="#de5059"
theme[download_end]="#ca2a40"

# Upload graph colors (Green -> Sky)
theme[upload_start]="#4a9e3a"
theme[upload_mid]="#2f9197"
theme[upload_end]="#30a4de"

# Process box color gradient for threads, mem and cpu usage (Sapphire -> Mauve)
theme[process_start]="#379eb1"
theme[process_mid]="#7589f3"
theme[process_end]="#8545e3"
