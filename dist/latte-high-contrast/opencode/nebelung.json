    "blue": "#2a6ae8",
    "lavender": "#7589f3",
    "sapphire": "#379eb1",
    "sky": "#30a4de",
    "teal": "#2f9197",
    "green": "#4a9e3a",
    "yellow": "#d99137",
    "peach": "#f66d2d",
