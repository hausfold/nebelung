
[delta "catppuccin-latte"]
	blame-palette = "#ffffff #f9f9f9 #eeeeee #dadada #c7c7c7"
	commit-decoration-style = "#a1a1a1" bold box ul
	light = true
	file-decoration-style = "#a1a1a1"
	file-style = "#434343"
	hunk-header-decoration-style = "#a1a1a1" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#686868"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#a1a1a1"
	line-numbers-minus-style = bold "#ca2a40"
	line-numbers-plus-style = bold "#4a9e3a"
	line-numbers-right-style = "#a1a1a1"
	line-numbers-zero-style = "#a1a1a1"
	# 35% red 65% base
	minus-emph-style = bold syntax "#edb5bc"
	# 20% red 80% base
	minus-style = syntax "#f4d4d9"
	# 35% green 65% base
	plus-emph-style = bold syntax "#c0ddba"
	# 20% green 80% base
	plus-style = syntax "#dbecd8"
	map-styles = \
		bold purple => syntax "#d4bef5", \
		bold blue => syntax "#b5cbf7", \
		bold cyan => syntax "#b7dff3", \
		bold yellow => syntax "#f2d9b9"
	# Should match the name of the bat theme
	syntax-theme = Catppuccin Latte

