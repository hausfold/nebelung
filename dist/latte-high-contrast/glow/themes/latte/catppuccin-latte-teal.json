{
  "document":    { "block_prefix": "\n", "block_suffix": "\n", "color": "#434343", "margin": 2 },
  "block_quote": { "color": "#686868", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph":   {},
  "list":        { "level_indent": 2 },
  "heading":     { "block_suffix": "\n", "color": "#434343", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#ffffff", "background_color": "#2f9197", "bold": true },
  "h2": { "prefix": "## ",     "color": "#2f9197",   "bold": true },
  "h3": { "prefix": "### ",    "color": "#7589f3", "bold": true },
  "h4": { "prefix": "#### ",   "color": "#2a6ae8",     "bold": true },
  "h5": { "prefix": "##### ",  "color": "#379eb1", "bold": true },
  "h6": { "prefix": "###### ", "color": "#686868", "bold": true },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph":   { "color": "#d77c7c", "italic": true },
  "strong": { "bold": true },
  "hr": { "color": "#a1a1a1", "format": "\n────────\n" },
  "item":        { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link":       { "color": "#2a6ae8",     "underline": true },
  "link_text":  { "color": "#7589f3", "bold": true },
  "image":      { "color": "#2a6ae8",     "underline": true },
  "image_text": { "color": "#8d8d8d", "format": "Image: {{.text}} →" },
  "code": { "prefix": " ", "suffix": " ", "color": "#f66d2d", "background_color": "#dadada" },
  "code_block": {
    "color": "#686868",
    "margin": 2,
    "chroma": {
      "text":            { "color": "#434343" },
      "error":           { "color": "#434343", "background_color": "#ca2a40" },
      "comment":         { "color": "#a1a1a1", "italic": true },
      "comment_preproc": { "color": "#2a6ae8" },
      "keyword":           { "color": "#8545e3" },
      "keyword_reserved":  { "color": "#8545e3" },
      "keyword_namespace": { "color": "#d99137" },
      "keyword_type":      { "color": "#d99137" },
      "operator":    { "color": "#30a4de" },
      "punctuation": { "color": "#7b7b7b" },
      "name":           { "color": "#434343" },
      "name_builtin":   { "color": "#f66d2d" },
      "name_tag":       { "color": "#8545e3" },
      "name_attribute": { "color": "#d99137" },
      "name_class":     { "color": "#d99137", "bold": true },
      "name_constant":  { "color": "#f66d2d" },
      "name_decorator": { "color": "#e47cc7" },
      "name_exception": { "color": "#ca2a40" },
      "name_function":  { "color": "#2a6ae8" },
      "name_other":     { "color": "#434343" },
      "literal":               { "color": "#f66d2d" },
      "literal_number":        { "color": "#f66d2d" },
      "literal_date":          { "color": "#f66d2d" },
      "literal_string":        { "color": "#4a9e3a" },
      "literal_string_escape": { "color": "#e47cc7" },
      "generic_deleted":    { "color": "#ca2a40" },
      "generic_emph":       { "italic": true },
      "generic_inserted":   { "color": "#4a9e3a" },
      "generic_strong":     { "bold": true },
      "generic_subheading": { "color": "#30a4de" },
      "background":         { "background_color": "#f9f9f9" }
    }
  },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "bold": true },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
