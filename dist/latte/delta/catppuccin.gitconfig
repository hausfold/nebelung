
[delta "catppuccin-latte"]
	blame-palette = "#f1f1f1 #e9e9e9 #e0e0e0 #d0d0d0 #c0c0c0"
	commit-decoration-style = "#a1a1a1" bold box ul
	light = true
	file-decoration-style = "#a1a1a1"
	file-style = "#515151"
	hunk-header-decoration-style = "#a1a1a1" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#717171"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#a1a1a1"
	line-numbers-minus-style = bold "#ca2a40"
	line-numbers-plus-style = bold "#4a9e3a"
	line-numbers-right-style = "#a1a1a1"
	line-numbers-zero-style = "#a1a1a1"
	# 35% red 65% base
	minus-emph-style = bold syntax "#e4acb3"
	# 20% red 80% base
	minus-style = syntax "#e9c9ce"
	# 35% green 65% base
	plus-emph-style = bold syntax "#b7d4b1"
	# 20% green 80% base
	plus-style = syntax "#d0e1cd"
	map-styles = \
		bold purple => syntax "#cbb5ec", \
		bold blue => syntax "#acc2ee", \
		bold cyan => syntax "#aed6ea", \
		bold yellow => syntax "#e9d0b0"
	# Should match the name of the bat theme
	syntax-theme = Catppuccin Latte

