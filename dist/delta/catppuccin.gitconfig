
[delta "catppuccin-mocha"]
	blame-palette = "#202020 #191919 #121212 #343434 #494949"
	commit-decoration-style = "#717171" bold box ul
	dark = true
	file-decoration-style = "#717171"
	file-style = "#d7d7d7"
	hunk-header-decoration-style = "#717171" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#aeaeae"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#717171"
	line-numbers-minus-style = bold "#ed8fa9"
	line-numbers-plus-style = bold "#abe1a6"
	line-numbers-right-style = "#717171"
	line-numbers-zero-style = "#717171"
	# 35% red 65% base
	minus-emph-style = bold syntax "#684750"
	# 20% red 80% base
	minus-style = syntax "#49373c"
	# 35% green 65% base
	plus-emph-style = bold syntax "#51644f"
	# 20% green 80% base
	plus-style = syntax "#3c473b"
	map-styles = \
		bold purple => syntax "#5b5069", \
		bold blue => syntax "#46546a", \
		bold cyan => syntax "#486166", \
		bold yellow => syntax "#6b6454"
	# Should match the name of the bat theme
	syntax-theme = Catppuccin Mocha
