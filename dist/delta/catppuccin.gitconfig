
[delta "catppuccin-mocha"]
	blame-palette = "#1a1a1a #141414 #0c0c0c #303030 #464646"
	commit-decoration-style = "#717171" bold box ul
	dark = true
	file-decoration-style = "#717171"
	file-style = "#d7d7d7"
	hunk-header-decoration-style = "#717171" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#aeaeae"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#717171"
	line-numbers-minus-style = bold "#ed8fa9"
	line-numbers-plus-style = bold "#abe1a6"
	line-numbers-right-style = "#717171"
	line-numbers-zero-style = "#717171"
	# 35% red 65% base
	minus-emph-style = bold syntax "#64434c"
	# 20% red 80% base
	minus-style = syntax "#443237"
	# 35% green 65% base
	plus-emph-style = bold syntax "#4d604b"
	# 20% green 80% base
	plus-style = syntax "#374236"
	map-styles = \
		bold purple => syntax "#574c65", \
		bold blue => syntax "#425066", \
		bold cyan => syntax "#445d62", \
		bold yellow => syntax "#676050"
	# Should match the name of the bat theme
	syntax-theme = Catppuccin Mocha
