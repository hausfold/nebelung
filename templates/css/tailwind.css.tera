---
whiskers:
  version: "2.4.0"
  matrix:
    - flavor
  filename: "nebelung-{{ flavor.identifier }}.tailwind.css"
  hex_format: "#{{r}}{{g}}{{b}}{{z}}"
---
{%- set ramp = ["text","subtext1","subtext0","overlay2","overlay1","overlay0","surface2","surface1","surface0","base","mantle","crust"] -%}
{%- set accents = ["rosewater","flamingo","pink","mauve","red","maroon","peach","yellow","green","teal","sky","sapphire","blue","lavender"] -%}
/* Nebelung {{ flavor.name }} — the palette as a Tailwind v4 theme.
 *
 * Generated by https://github.com/hausfold/nebelung — do not edit by hand.
 *
 * Tailwind v4 has no JS config: a theme IS css. Import it after Tailwind and
 * every colour becomes a utility (bg-nebelung-base, text-nebelung-mauve,
 * border-nebelung-surface1, …) plus a --color-nebelung-* custom property.
 *
 *   @import "tailwindcss";
 *   @import "./nebelung-{{ flavor.identifier }}.tailwind.css";
 *
 * The names are namespaced, so Tailwind's own red/blue/pink/sky survive intact.
 * Nothing here needs nebelung-{{ flavor.identifier }}.css — that file is the same palette for
 * projects with no Tailwind; take one or the other, not both.
 */

@theme {
  /* Neutral ramp, lightest → darkest. */
{% for name in ramp %}  --color-nebelung-{{ name }}: {{ flavor.colors[name].hex }};
{% endfor %}
  /* Accents. */
{% for name in accents %}  --color-nebelung-{{ name }}: {{ flavor.colors[name].hex }};
{% endfor %}
  /* Semantic aliases — bg-nebelung-accent, text-nebelung-fg-muted, and so on. */
  --color-nebelung-bg: var(--color-nebelung-base);
  --color-nebelung-bg-alt: var(--color-nebelung-mantle);
  --color-nebelung-bg-deep: var(--color-nebelung-crust);
  --color-nebelung-fg: var(--color-nebelung-text);
  --color-nebelung-fg-muted: var(--color-nebelung-subtext0);
  --color-nebelung-border: var(--color-nebelung-surface1);
  --color-nebelung-accent: var(--color-nebelung-mauve);
  --color-nebelung-success: var(--color-nebelung-green);
  --color-nebelung-warning: var(--color-nebelung-yellow);
  --color-nebelung-danger: var(--color-nebelung-red);
  --color-nebelung-info: var(--color-nebelung-teal);
}

:root {
  color-scheme: {% if flavor.dark %}dark{% else %}light{% endif %};
}
