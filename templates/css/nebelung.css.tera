---
whiskers:
  version: "2.4.0"
  matrix:
    - flavor
  filename: "nebelung-{{ flavor.identifier }}.css"
  hex_format: "#{{r}}{{g}}{{b}}{{z}}"
---
{%- set ramp = ["text","subtext1","subtext0","overlay2","overlay1","overlay0","surface2","surface1","surface0","base","mantle","crust"] -%}
{%- set accents = ["rosewater","flamingo","pink","mauve","red","maroon","peach","yellow","green","teal","sky","sapphire","blue","lavender"] -%}
/* Nebelung {{ flavor.name }} — the palette as CSS custom properties.
 *
 * Generated by https://github.com/hausfold/nebelung — do not edit by hand.
 *
 *   @import url("nebelung-{{ flavor.identifier }}.css");
 *
 * Everything lands on :root, so `var(--nebelung-mauve)` resolves anywhere. For
 * a translucent shade, don't add a second variable — derive it at the point of
 * use with relative colour syntax or color-mix():
 *
 *   background: rgb(from var(--nebelung-mauve) r g b / 0.15);
 *   border-color: color-mix(in oklab, var(--nebelung-mauve) 30%, transparent);
 *
 * Light + dark from one sheet: import each flavour behind its own media query,
 * so only one of them ever defines :root. The two files ship in sibling dirs
 * (css/ and latte/css/) — these paths are wherever you copied them to.
 *
 *   @import url("nebelung-mocha.css") (prefers-color-scheme: dark);
 *   @import url("nebelung-latte.css") (prefers-color-scheme: light);
 */

:root {
  color-scheme: {% if flavor.dark %}dark{% else %}light{% endif %};

  /* Neutral ramp, lightest → darkest. */
{% for name in ramp %}  --nebelung-{{ name }}: {{ flavor.colors[name].hex }};
{% endfor %}
  /* Accents. */
{% for name in accents %}  --nebelung-{{ name }}: {{ flavor.colors[name].hex }};
{% endfor %}
  /* Semantic aliases — the names to reach for first. Override any of these in
   * your own :root to re-point the system without touching the ramp above. */
  --nebelung-bg: var(--nebelung-base);
  --nebelung-bg-alt: var(--nebelung-mantle);
  --nebelung-bg-deep: var(--nebelung-crust);
  --nebelung-fg: var(--nebelung-text);
  --nebelung-fg-muted: var(--nebelung-subtext0);
  --nebelung-border: var(--nebelung-surface1);
  --nebelung-accent: var(--nebelung-mauve);
  --nebelung-success: var(--nebelung-green);
  --nebelung-warning: var(--nebelung-yellow);
  --nebelung-danger: var(--nebelung-red);
  --nebelung-info: var(--nebelung-teal);
}
