---
whiskers:
  version: "^2.0"
# Both overridden per render by build.sh (`--overrides`): the variant so the page
# can light up its own pill in the switcher, and the port count so no number here
# can outlive ports.meta.json.
variant: nebelung
ports: 0
variants:
  - id: nebelung
    file: nebelung.html
    mode: dark
    label: dark
    note: normal contrast
  - id: nebelung-high-contrast
    file: nebelung-high-contrast.html
    mode: dark
    label: dark
    note: high contrast
  - id: nebelung-latte
    file: nebelung-latte.html
    mode: light
    label: light
    note: normal contrast
  - id: nebelung-latte-high-contrast
    file: nebelung-latte-high-contrast.html
    mode: light
    label: light
    note: high contrast
---
{%- set accents = ["rosewater","flamingo","pink","mauve","red","maroon","peach","yellow","green","teal","sky","sapphire","blue","lavender"] -%}
{%- set ramp = ["crust","mantle","base","surface0","surface1","surface2","overlay0","overlay1","overlay2","subtext0","subtext1","text"] -%}
{%- set me = variant -%}
{%- set_global vlabel = flavor.name -%}
{%- set_global vnote = "" -%}
{%- for v in variants %}{% if v.id == me %}{% set_global vlabel = v.label %}{% set_global vnote = v.note %}{% endif %}{% endfor -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Nebelung — {{ vlabel }}, {{ vnote }}</title>
<meta name="description" content="Live preview of the Nebelung palette ({{ variant }}) — 14 accents, 12 neutrals, and the theme in an editor and a terminal." />
<meta name="color-scheme" content="{% if flavor.dark %}dark light{% else %}light dark{% endif %}" />
<style>
  :root {
    color-scheme: {% if flavor.dark %}dark{% else %}light{% endif %};
{%- for name, c in flavor.colors %}
    --{{ name }}: #{{ c.hex }};
{%- endfor %}
    --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
    --sans: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    --pad: clamp(18px, 4vw, 44px);
    --radius: 14px;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--crust);
    color: var(--text);
    font: 15px/1.55 var(--sans);
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 var(--pad) 64px; }

  /* ── top bar ─────────────────────────────────────────────── */
  .top {
    position: sticky; top: 0; z-index: 10;
    background: color-mix(in srgb, var(--crust) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--surface0);
  }
  .top .wrap {
    padding: 12px var(--pad); display: flex; flex-wrap: wrap;
    gap: 10px 16px; align-items: center; justify-content: space-between;
  }
  .brand {
    font: 600 15px/1 var(--sans); letter-spacing: .02em;
    text-decoration: none; display: inline-flex; align-items: center; gap: 9px;
  }
  .brand .fog {
    width: 11px; height: 11px; border-radius: 50%;
    background: linear-gradient(135deg, var(--text), var(--overlay0));
  }
  /* One row, always: on a phone the pills scroll sideways rather than wrapping
     into a second row that doubles the height of a bar pinned to the top. The
     clipped last pill is the affordance; the scrollbar itself is hidden because
     it would sit on the bar's bottom border. */
  .switch {
    display: flex; gap: 6px; flex: 0 1 auto; min-width: 0; margin-left: auto;
    overflow-x: auto; overscroll-behavior-x: contain;
    scrollbar-width: none; -ms-overflow-style: none;
  }
  .switch::-webkit-scrollbar { display: none; }
  .pill {
    display: inline-flex; flex-direction: column; gap: 1px;
    padding: 6px 12px; border-radius: 999px;
    border: 1px solid var(--surface0); background: var(--mantle);
    color: var(--subtext0); text-decoration: none;
    font-size: 12.5px; line-height: 1.25; white-space: nowrap;
    transition: border-color .15s, color .15s, background .15s;
  }
  .pill small { font-size: 10.5px; color: var(--overlay1); }
  .pill:hover { border-color: var(--overlay0); color: var(--text); }
  .pill[aria-current="page"] {
    background: var(--surface0); border-color: var(--overlay0); color: var(--text);
  }
  .pill[aria-current="page"] small { color: var(--subtext0); }

  /* ── hero ────────────────────────────────────────────────── */
  .hero { padding: clamp(28px, 6vw, 56px) 0 clamp(20px, 4vw, 32px); }
  h1 {
    margin: 0; font-size: clamp(28px, 7vw, 42px); font-weight: 600;
    letter-spacing: -.02em;
  }
  h1 .dim { color: var(--overlay1); font-weight: 400; }
  .lede {
    margin: 10px 0 0; max-width: 52ch;
    color: var(--subtext0); font-size: clamp(14px, 3.4vw, 16px);
  }
  .facts {
    list-style: none; display: flex; flex-wrap: wrap; gap: 8px;
    margin: 22px 0 0; padding: 0;
  }
  .facts li {
    background: var(--mantle); border: 1px solid var(--surface0);
    border-radius: 999px; padding: 5px 12px;
    font-size: 12.5px; color: var(--subtext0);
  }
  .facts b { color: var(--text); font-family: var(--mono); font-weight: 600; }

  /* ── sections ────────────────────────────────────────────── */
  section { margin-top: clamp(30px, 6vw, 46px); }
  h2 {
    margin: 0 0 14px; font-size: 13px; font-weight: 600;
    text-transform: uppercase; letter-spacing: .12em; color: var(--overlay2);
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px;
  }
  h2 .hint {
    text-transform: none; letter-spacing: 0; font-weight: 400;
    font-size: 12px; color: var(--overlay1);
  }

  .grid { display: grid; gap: 8px; }
  .accents { grid-template-columns: repeat(auto-fill, minmax(min(100%, 118px), 1fr)); }
  /* 74px keeps all twelve steps on one line at full width — the ramp reads as a
     ramp — and wraps to three or four per row on a phone. */
  .ramp { grid-template-columns: repeat(auto-fill, minmax(min(100%, 74px), 1fr)); }
  .sw {
    -webkit-appearance: none; appearance: none;
    font: inherit; text-align: left; cursor: copy;
    border: 1px solid color-mix(in srgb, var(--overlay0) 45%, transparent);
    border-radius: 10px; padding: 10px; min-height: 74px;
    display: flex; flex-direction: column; justify-content: flex-end; gap: 1px;
    transition: transform .12s ease, box-shadow .12s ease;
  }
  .sw:hover { transform: translateY(-2px); }
  .sw:focus-visible { outline: 2px solid var(--text); outline-offset: 2px; }
  .sw span { font-size: 12px; font-weight: 600; }
  .sw small { font-family: var(--mono); font-size: 10.5px; opacity: .92; }
  .ramp .sw { min-height: 62px; }

  /* ── mockups ─────────────────────────────────────────────── */
  .panel {
    background: var(--base); border: 1px solid var(--surface0);
    border-radius: var(--radius); overflow: hidden; margin-bottom: 14px;
  }
  .titlebar {
    background: var(--mantle); padding: 9px 14px;
    border-bottom: 1px solid var(--surface0); color: var(--subtext1);
    display: flex; gap: 7px; align-items: center;
    font-family: var(--mono); font-size: 12px;
  }
  .dot { width: 11px; height: 11px; border-radius: 50%; display: inline-block; }
  .titlebar .name { margin-left: 6px; }
  .code {
    padding: 14px 16px; margin: 0; overflow-x: auto;
    font-family: var(--mono); font-size: clamp(11.5px, 2.9vw, 13px);
    line-height: 1.7; white-space: pre;
  }
  .ln { color: var(--overlay0); user-select: none; margin-right: 14px; }
  .kw { color: var(--mauve); }
  .fn { color: var(--blue); }
  .str { color: var(--green); }
  .num { color: var(--peach); }
  .cmt { color: var(--overlay1); font-style: italic; }
  .ty { color: var(--yellow); }
  .op { color: var(--sky); }
  .sel { background: var(--surface1); }
  .add { color: var(--green); }
  .del { color: var(--red); }
  .prompt .a { color: var(--green); } .prompt .b { color: var(--blue); }
  .prompt .c { color: var(--teal); }

  /* a small slice of app chrome — the accents doing UI work, not syntax work */
  .ui { padding: 16px; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .btn {
    border: 0; border-radius: 9px; padding: 8px 15px;
    font: 600 13px/1 var(--sans); cursor: default;
    background: var(--mauve); color: var(--base);
  }
  .btn.ghost { background: var(--surface0); color: var(--text); }
  .tag {
    border-radius: 999px; padding: 4px 11px; font-size: 12px;
    font-family: var(--mono);
    border: 1px solid currentColor;
  }
  .tag.ok { color: var(--green); }
  .tag.warn { color: var(--yellow); }
  .tag.err { color: var(--red); }
  .bar { flex: 1 1 160px; height: 7px; border-radius: 999px; background: var(--surface0); overflow: hidden; }
  .bar i { display: block; height: 100%; width: 62%; background: var(--teal); }

  /* ── footer + toast ──────────────────────────────────────── */
  footer {
    margin-top: clamp(40px, 8vw, 64px); padding-top: 22px;
    border-top: 1px solid var(--surface0);
    color: var(--overlay1); font-size: 13px;
    display: flex; flex-wrap: wrap; gap: 8px 18px;
  }
  footer a { color: var(--subtext0); }
  #toast {
    position: fixed; left: 50%; bottom: 22px; transform: translate(-50%, 12px);
    background: var(--surface0); color: var(--text);
    border: 1px solid var(--overlay0); border-radius: 999px;
    padding: 8px 16px; font-family: var(--mono); font-size: 12.5px;
    opacity: 0; pointer-events: none; transition: opacity .18s, transform .18s;
  }
  #toast.on { opacity: 1; transform: translate(-50%, 0); }
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
  }
</style>
</head>
<body>

<header class="top">
  <div class="wrap">
    <a class="brand" href="https://github.com/hausfold/nebelung"><span class="fog"></span>nebelung</a>
    <nav class="switch" aria-label="variant">
      {%- for v in variants %}
      <a class="pill" href="{{ v.file }}"{% if v.id == me %} aria-current="page"{% endif %}>{{ v.label }}<small>{{ v.note }}</small></a>
      {%- endfor %}
    </nav>
  </div>
</header>

<div class="wrap">

  <div class="hero">
    <h1>{{ vlabel }}<span class="dim"> · {{ vnote }}</span></h1>
    <p class="lede">
      Catppuccin with the ~240° blue lifted out of the neutrals: chroma 0 down the
      whole ramp, accents calmed to ×0.9. Same structure, same slots — grey where
      the blue was.
    </p>
    <ul class="facts">
      <li><b id="ratio">—</b> text on base</li>
      <li><b>{{ variant }}</b> palette</li>
      <li>renders as catppuccin <b>{{ flavor.name }}</b></li>
      <li><b>{{ ports }}</b> ports</li>
    </ul>
  </div>

  <section>
    <h2>accents <span class="hint">click a swatch to copy its hex</span></h2>
    <div class="grid accents">
      {%- for name in accents %}
      {%- set c = flavor.colors[name] %}
      <button class="sw" data-hex="#{{ c.hex }}" style="background:#{{ c.hex }}"><span>{{ name }}</span><small>#{{ c.hex }}</small></button>
      {%- endfor %}
    </div>
  </section>

  <section>
    <h2>neutrals <span class="hint">crust → text, chroma 0 all the way</span></h2>
    <div class="grid ramp">
      {%- for name in ramp %}
      {%- set c = flavor.colors[name] %}
      <button class="sw" data-hex="#{{ c.hex }}" style="background:#{{ c.hex }}"><span>{{ name }}</span><small>#{{ c.hex }}</small></button>
      {%- endfor %}
    </div>
  </section>

  <section>
    <h2>in situ</h2>

    <div class="panel">
      <div class="titlebar">
        <span class="dot" style="background:var(--red)"></span>
        <span class="dot" style="background:var(--yellow)"></span>
        <span class="dot" style="background:var(--green)"></span>
        <span class="name">nebelung.rs</span>
      </div>
      <pre class="code"><span class="ln">1</span><span class="cmt">// strip the blue, keep the cat</span>
<span class="ln">2</span><span class="kw">use</span> catppuccin<span class="op">::</span><span class="ty">Flavor</span>;
<span class="ln">3</span>
<span class="ln">4</span><span class="kw">pub fn</span> <span class="fn">neutralize</span>(c<span class="op">:</span> <span class="ty">Color</span>) <span class="op">-></span> <span class="ty">Color</span> {
<span class="ln">5</span>    <span class="kw">let</span> keep <span class="op">=</span> c.<span class="fn">lightness</span>(); <span class="cmt">// perceptual, untouched</span>
<span class="ln">6</span><span class="sel">    c.<span class="fn">with_chroma</span>(<span class="num">0.0</span>).<span class="fn">with_lightness</span>(keep)</span>
<span class="ln">7</span>}
<span class="ln">8</span>
<span class="ln">9</span><span class="kw">let</span> name <span class="op">=</span> <span class="str">"nebelung"</span>;</pre>
    </div>

    <div class="panel">
      <pre class="code"><span class="prompt"><span class="a">~/code/nebelung</span> <span class="b">git:(</span><span class="c">main</span><span class="b">)</span></span> ./build.sh
<span class="add">✓</span> rendered <span class="ty">{{ ports }}</span> ports against the <span class="ty">{{ variant }}</span> palette
<span class="add">+</span><span class="add"> dist/ghostty/themes/catppuccin-{{ flavor.identifier }}.conf</span>
<span class="del">-</span><span class="del"> dist/ghostty/themes/old.conf</span>
<span class="cmt">→ preview → preview/{{ variant }}.html</span></pre>
    </div>

    <div class="panel">
      <div class="ui">
        <button class="btn">Apply theme</button>
        <button class="btn ghost">Cancel</button>
        <span class="tag ok">passing</span>
        <span class="tag warn">3 stale</span>
        <span class="tag err">1 failed</span>
        <span class="bar"><i></i></span>
      </div>
    </div>
  </section>

  <footer>
    <span>the same palette, {{ variants | length }} ways</span>
    <a href="https://github.com/hausfold/nebelung">repo</a>
    <a href="https://github.com/hausfold/nebelung/blob/main/docs/ports.md">ports</a>
    <a href="https://github.com/hausfold/nebelung/blob/main/docs/install.md">install</a>
  </footer>
</div>

<div id="toast" role="status" aria-live="polite"></div>

<script>
  // Contrast and label colours are computed from the rendered palette rather
  // than baked in, so a retune of the ramp can never leave this page lying.
  const lum = (hex) => {
    const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255)
      .map((c) => (c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4)));
    return 0.2126 * r + 0.7152 * g + 0.0722 * b;
  };
  const ratio = (a, b) => {
    const [x, y] = [lum(a), lum(b)].sort((m, n) => n - m);
    return (x + 0.05) / (y + 0.05);
  };

  const css = (name) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  const text = css("--text"), base = css("--base"), crust = css("--crust");

  const r = ratio(text, base);
  document.getElementById("ratio").textContent =
    r.toFixed(1) + ":1 " + (r >= 7 ? "AAA" : r >= 4.5 ? "AA" : "·");

  // Each swatch labels itself with whichever candidate it can be read on. Both
  // ends of the ramp sit at the light end in Latte, so palette colours alone
  // leave mid-lightness swatches around 2.5:1 — black and white are in the pool
  // to keep every label above 4.5:1 in all four variants.
  for (const sw of document.querySelectorAll(".sw")) {
    const hex = sw.dataset.hex;
    sw.style.color = [crust, text, "#000000", "#ffffff"]
      .reduce((best, c) => (ratio(hex, c) > ratio(hex, best) ? c : best));
  }

  // Narrow enough and the pills scroll sideways, which can leave the page you're
  // on parked off-screen. Centre it, measured off the rects rather than
  // offsetLeft — the pills' offsetParent is the sticky bar, not the strip they
  // sit in. Sideways only, so it can't disturb the vertical scroll below.
  const here = document.querySelector('.switch .pill[aria-current="page"]');
  if (here) {
    const nav = here.parentElement;
    nav.scrollLeft += here.getBoundingClientRect().left - nav.getBoundingClientRect().left
      - (nav.clientWidth - here.offsetWidth) / 2;
  }

  // The pills are this same page in another palette, so switching between two of
  // them is a comparison, not a new read: hand the scroll offset to the next page
  // and pick it up there. Consumed on arrival, so a reload or a fresh visit still
  // starts at the top. sessionStorage is unavailable on some file:// origins —
  // there the pages just behave as they did before.
  const SCROLL_KEY = "nebelung:preview:scroll";
  try {
    const handoff = sessionStorage.getItem(SCROLL_KEY);
    sessionStorage.removeItem(SCROLL_KEY);
    if (handoff !== null) window.scrollTo(0, Number(handoff));
    for (const pill of document.querySelectorAll(".switch .pill")) {
      pill.addEventListener("click", (e) => {
        // A modified click opens a new tab; this one stays where it is, and its
        // own offset would go stale sitting in storage unread.
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        sessionStorage.setItem(SCROLL_KEY, String(window.scrollY));
      });
    }
  } catch {}

  const toast = document.getElementById("toast");
  let timer;
  const flash = (msg) => {
    toast.textContent = msg;
    toast.classList.add("on");
    clearTimeout(timer);
    timer = setTimeout(() => toast.classList.remove("on"), 1400);
  };
  for (const sw of document.querySelectorAll(".sw")) {
    sw.addEventListener("click", async () => {
      const hex = sw.dataset.hex;
      try {
        await navigator.clipboard.writeText(hex);
        flash("copied " + hex);
      } catch {
        flash(hex);
      }
    });
  }
</script>
</body>
</html>
